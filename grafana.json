     },
     "editorType": "sql",
     "format": 2,
     "queryType": "logs",
     "rawSql": "SELECT timestamp, message AS body, multiIf(match(message, '(?i)(error|fatal|panic|exception|traceback)'), 'error', match(message, '(?i)(warn)'), 'warning', match(message, '(?i)(debug|trace)'), 'debug', 'info') AS level, namespace, pod_name, container, node\nFROM observability.logs WHERE $__timeFilter(timestamp) AND namespace IN (${namespace:singlequote}) AND match(pod_name, '${pod_search:raw}') AND positionCaseInsensitive(message, '${log_search:raw}') > 0\nORDER BY timestamp DESC LIMIT 1000",
