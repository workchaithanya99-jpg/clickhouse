      "uid": "${ds_ch}"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(timestamp) AS time, multiIf(match(message, '(?i)(error|fatal|panic|exception|traceback)'), 'error', match(message, '(?i)(warn)'), 'warning', match(message, '(?i)(debug|trace)'), 'debug', 'info') AS level, count() AS lines FROM observability.logs\nWHERE $__timeFilter(timestamp) AND namespace IN (${namespace:singlequote}) AND match(pod_name, '${pod_search:raw}') AND positionCaseInsensitive(message, '${log_search:raw}') > 0 GROUP BY time, level ORDER BY time",
     "refId": "A"
    }
