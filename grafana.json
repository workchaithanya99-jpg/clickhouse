  {
   "type": "timeseries",
   "title": "Query latency (SELECT) p50 / p95 / p99 in ms",
   "description": "",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "${ds_ch}"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "${ds_ch}"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT $__timeInterval(event_time) AS time, quantile(0.5)(query_duration_ms) AS p50, quantile(0.95)(query_duration_ms) AS p95, quantile(0.99)(query_duration_ms) AS p99\nFROM system.query_log WHERE $__timeFilter(event_time) AND type = 'QueryFinish' AND query_kind = 'Select' GROUP BY time ORDER BY time",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
