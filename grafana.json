  {
   "type": "table",
   "title": "Nodes",
   "description": "Live node inventory. CPU %/Mem % come from node-exporter; 'Max pods' is the kubelet's allocatable pod count.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "${ds_ch}"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "${ds_ch}"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT node AS \"Node\", internal_ip AS \"Internal IP\", external_ip AS \"Public IP\", nodegroup AS \"Node group\",\n  instance_type AS \"Type\", capacity_type AS \"Capacity\", zone AS \"AZ\",\n  node_class AS \"Class\", if(is_tainted = 1, 'Tainted', 'Untainted') AS \"Taint\",\n  arrayStringConcat(taints, ',  ') AS \"Taints\", if(ready = 1, 'Ready', 'NotReady') AS \"Status\",\n  pods_scheduled AS \"Pods\", pods_alloc AS \"Max pods\", round(100 * pods_scheduled / nullIf(pods_alloc, 0), 1) AS \"Pod slots %\",\n  cpu_used_pct AS \"CPU %\", mem_used_pct AS \"Mem %\", cpu_alloc_m AS \"CPU alloc (m)\", mem_alloc_b AS \"Mem alloc\", kubelet_version AS \"Kubelet\"\nFROM observability.node_latest WHERE node IN (${node:singlequote}) ORDER BY node",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1e+18
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Taint"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "Tainted": {
            "color": "orange",
            "index": 0,
            "text": "Tainted"
           },
           "Untainted": {
            "color": "green",
            "index": 1,
            "text": "Untainted"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "custom.width",
        "value": 130
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Class"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
