  {
   "type": "table",
   "title": "Older logs straight from the S3 archive (set s3_year / s3_month / s3_day at the top)",
   "description": "Reads the gzip archive Fluent Bit writes to S3, through ClickHouse's s3() function. Only the chosen day's folder is scanned, so keep it to one day at a time (or use day=* for a whole month on small clusters).",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "${ds_ch}"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "${ds_ch}"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT timestamp AS \"Time\", namespace AS \"Namespace\", pod_name AS \"Pod\", container AS \"Container\", message AS \"Message\"\nFROM s3('https://${s3_bucket}.s3.${s3_region}.amazonaws.com/pod-logs/year=${s3_year}/month=${s3_month}/day=${s3_day}/**/*.gz',\n        'JSONEachRow', 'timestamp DateTime64(3), namespace String, pod_name String, container String, message String', 'gzip')\nWHERE namespace IN (${namespace:singlequote}) AND match(pod_name, '${pod_search:raw}') AND positionCaseInsensitive(message, '${log_search:raw}') > 0\nORDER BY timestamp DESC LIMIT 500\nSETTINGS date_time_input_format = 'best_effort', input_format_skip_unknown_fields = 1",
     "refId": "A"
    }
   ],
