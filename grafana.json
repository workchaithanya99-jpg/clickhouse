     "rawSql": "SELECT namespace AS \"Namespace\", pod AS \"Pod\", if(node = '', '(unscheduled)', node) AS \"Node\", state AS \"State\", restarts AS \"Restarts\", last_term_reason AS \"Last exit\",\n  round(cpu_use_m) AS \"CPU use (m)\", cpu_lim_m AS \"CPU limit (m)\", round(100 * cpu_use_m / nullIf(cpu_lim_m, 0), 1) AS \"CPU % of limit\",\n  mem_use_b AS \"Mem use\", mem_lim_b AS \"Mem limit\", round(100 * mem_use_b / nullIf(mem_lim_b, 0), 1) AS \"Mem % of limit\"\nFROM observability.pod_latest WHERE match(pod, '${db_pod_regex:raw}') ORDER BY namespace, pod",
