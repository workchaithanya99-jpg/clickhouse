  {
   "id": 12,
   "type": "row",
   "title": "3 \u00b7 Per node \u2014 workloads, replicas, CPU & memory vs. limits",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
