  {
   "type": "table",
   "title": "Deployments per node (one row per deployment \u2014 pods are aggregated, never repeated)",
   "description": "Each deployment appears once per node it runs on. 'Pods on node' = replicas of that deployment placed on this node. Limits/requests are the sums of what is set in the YAML; '% of limit' only counts pods that have a limit. Replicas show '-' for Jobs/CronJobs/bare pods.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "${ds_ch}"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "${ds_ch}"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT if(p.node = '', '(unscheduled)', p.node) AS \"Node\", any(p.host_ip) AS \"Node IP\", p.namespace AS \"Namespace\",\n  p.workload_kind AS \"Kind\", p.workload AS \"Deployment\",\n  max(d.desired) AS \"Replicas desired\", max(d.ready) AS \"Replicas ready\", count() AS \"Pods on node\",\n  round(sum(p.cpu_use_m)) AS \"CPU use (m)\", sum(p.cpu_req_m) AS \"CPU request (m)\", sumIf(p.cpu_lim_m, p.cpu_lim_m > 0) AS \"CPU limit (m)\",\n  round(100 * sumIf(p.cpu_use_m, p.cpu_lim_m > 0) / nullIf(sumIf(p.cpu_lim_m, p.cpu_lim_m > 0), 0), 1) AS \"CPU % of limit\",\n  round(100 * sumIf(p.cpu_use_m, p.cpu_req_m > 0) / nullIf(sumIf(p.cpu_req_m, p.cpu_req_m > 0), 0), 1) AS \"CPU % of request\",\n  sum(p.mem_use_b) AS \"Mem use\", sum(p.mem_req_b) AS \"Mem request\", sumIf(p.mem_lim_b, p.mem_lim_b > 0) AS \"Mem limit\",\n  round(100 * sumIf(p.mem_use_b, p.mem_lim_b > 0) / nullIf(sumIf(p.mem_lim_b, p.mem_lim_b > 0), 0), 1) AS \"Mem % of limit\",\n  round(100 * sumIf(p.mem_use_b, p.mem_req_b > 0) / nullIf(sumIf(p.mem_req_b, p.mem_req_b > 0), 0), 1) AS \"Mem % of request\",\n  countIf(p.cpu_lim_m = 0 OR p.mem_lim_b = 0) AS \"Pods w/o limit\"\nFROM observability.pod_latest AS p\nLEFT JOIN observability.deployment_latest AS d ON d.namespace = p.namespace AND d.name = p.workload AND d.kind = p.workload_kind\nWHERE (p.node IN (${node:singlequote}) OR p.node = '') AND p.namespace IN (${namespace:singlequote})\nGROUP BY p.node, p.namespace, p.workload_kind, p.workload\nORDER BY p.node, p.namespace, p.workload\nSETTINGS join_use_nulls = 1",
     "refId": "A"
