     "queryType": "table",
     "rawSql": "SELECT d.namespace AS \"Namespace\", d.name AS \"Deployment\", d.kind AS \"Kind\",\n  d.desired AS \"Desired\", d.ready AS \"Ready\", d.available AS \"Available\", d.updated AS \"Updated\",\n  multiIf(d.desired = 0, 'ScaledToZero', d.ready >= d.desired, 'Healthy', d.ready = 0, 'Down', 'Degraded') AS \"Status\",\n  uniqExactIf(p.node, p.node != '') AS \"Nodes used\", arrayStringConcat(groupUniqArrayIf(p.node, p.node != ''), ', ') AS \"Node list\",\n  sum(p.restarts) AS \"Restarts\", round(sum(p.cpu_use_m)) AS \"CPU use (m)\", sumIf(p.cpu_lim_m, p.cpu_lim_m > 0) AS \"CPU limit (m)\",\n  round(100 * sumIf(p.cpu_use_m, p.cpu_lim_m > 0) / nullIf(sumIf(p.cpu_lim_m, p.cpu_lim_m > 0), 0), 1) AS \"CPU % of limit\",\n  sum(p.mem_use_b) AS \"Mem use\", sumIf(p.mem_lim_b, p.mem_lim_b > 0) AS \"Mem limit\",\n  round(100 * sumIf(p.mem_use_b, p.mem_lim_b > 0) / nullIf(sumIf(p.mem_lim_b, p.mem_lim_b > 0), 0), 1) AS \"Mem % of limit\",\n  arrayStringConcat(any(d.images), ', ') AS \"Images\"\nFROM observability.deployment_latest AS d\nLEFT JOIN observability.pod_latest AS p ON p.namespace = d.namespace AND p.workload = d.name AND p.workload_kind = d.kind\nWHERE d.namespace IN (${namespace:singlequote}) AND match(d.name, '${pod_search:raw}')\nGROUP BY d.namespace, d.name, d.kind, d.desired, d.ready, d.available, d.updated\nORDER BY (d.ready < d.desired) DESC, d.namespace, d.name",
